generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TelegramFreeTrial {
  telegramId BigInt   @id
  usedAt     DateTime @default(now())
}

model User {
  id              Int       @id @default(autoincrement())
  telegramId      BigInt    @unique
  username        String?
  name            String?
  age             Int?
  goals           String[]  @default([])
  referralCode    String    @unique
  referralCredits Int       @default(0)
  referredBy      Int?
  subscriptionEnd DateTime?
  reminderEnabled      Boolean @default(false)
  reminderTime         String? // "HH:mm" in reminderTimezone
  reminderTimezone     String? // IANA tz, e.g. Europe/Moscow
  reminderLastSentDate String? // "YYYY-MM-DD" in reminderTimezone
  personalizedAnalysis Boolean @default(true)
  darkTheme            Boolean @default(false)
  onboarded       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  analyses        Analysis[]
  tasks           TaskCompletion[]
  referralProofs  ReferralProof[]
}

model Analysis {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   // "face" | "hairstyle"
  photoUrl     String
  photoData    Bytes?
  sidePhotoUrl String?
  resultJson   Json
  overallScore Int?
  demo         Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model TaskCompletion {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskKey   String
  date      DateTime @db.Date

  @@unique([userId, taskKey, date])
}

model ReferralProof {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrls  String[] // one screenshot per TikTok comment (5 total)
  status     String   @default("pending") // pending | approved | rejected
  createdAt  DateTime @default(now())
}
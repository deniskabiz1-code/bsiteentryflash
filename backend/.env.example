# Supabase → Project Settings → Database → Connection string
# Render cannot reach db.[ref].supabase.co (IPv6) — use BOTH pooler URLs below.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Session pooler (port 5432 on pooler host) — NOT db.[ref].supabase.co
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

PORT=3001
BOT_TOKEN="your-telegram-bot-token"
BOT_USERNAME="primeform_bot"
CHANNEL_USERNAME="primeformnews"
# Optional: numeric ID for private channels, e.g. -1001234567890
CHANNEL_ID=""
# Optional: private channel invite link, e.g. https://t.me/+AbCdEfGh
CHANNEL_INVITE_LINK=""
# Leave empty to serve demo analysis results (no real AI calls)
OPENAI_API_KEY="sk-..."
# OpenAI-compatible API (optional — defaults to OpenAI when empty)
# Custom proxy: https://vip.j3gb.com  (server auto-appends /v1)
# DeepSeek:      https://api.deepseek.com
# OpenRouter:    https://openrouter.ai/api/v1
OPENAI_BASE_URL=""
# Model name on your provider (e.g. gpt-5.5, gpt-4o)
OPENAI_MODEL=""
# Optional reasoning effort for compatible models (low | medium | high | xhigh)
OPENAI_REASONING_EFFORT=""
# Set false for custom proxies (vip.j3gb.com etc.) — default false when OPENAI_BASE_URL is set
OPENAI_JSON_MODE=false
# high | low | auto — low is faster and more reliable on mobile selfies
OPENAI_VISION_DETAIL=low
# Force demo analysis even when OPENAI_API_KEY is set
USE_DEMO_ANALYSIS=false
# Return identical demo scores when AI fails (off in production — users should see an error)
AI_FALLBACK_DEMO=false
# Primary vision timeout (ms). Retry uses OPENAI_RETRY_TIMEOUT_MS (default 45000).
OPENAI_TIMEOUT_MS=90000
OPENAI_RETRY_TIMEOUT_MS=45000
# Set false before public launch to hide test credit API
ENABLE_TEST_CREDITS=true
ROBOKASSA_LOGIN="your-merchant-login"
ROBOKASSA_PASSWORD1="password1"
ROBOKASSA_PASSWORD2="password2"
ROBOKASSA_TEST_MODE=true

# Your GitHub Pages URL — same URL as BotFather Mini App / menu button (no trailing slash)
FRONTEND_URL="https://yourusername.github.io/primeform"
APP_URL="https://yourusername.github.io/primeform"

ADMIN_SECRET="your-admin-secret-header"
# Your Telegram user ID — bot DMs you TikTok proofs + analysis selfies
ADMIN_TELEGRAM_ID=""
# Set false to stop analysis photo notifications (TikTok proofs still send)
ADMIN_NOTIFY_ANALYSES=true
# Public backend URL for admin image links (Render sets RENDER_EXTERNAL_URL automatically)
API_PUBLIC_URL="https://your-api.onrender.com"
REMINDER_TIMEZONE="Europe/Moscow"
UPLOAD_DIR="./uploads"